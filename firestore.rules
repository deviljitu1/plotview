rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Projects: anyone can read, only authenticated admin can write project-level
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Plots subcollection: anyone can read
      // Anyone can UPDATE a plot (client manager uses password-based auth on frontend)
      // Only authenticated admin can create/delete plots
      match /plots/{plotId} {
        allow read: if true;
        allow update: if true;  // Client manager needs this to change status
        allow create, delete: if request.auth != null;
      }
    }
  }
}
